<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgConvIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_history"
        android:background="@drawable/menu_icon_bg"
        android:padding="8dp"
        app:tint="#38BDF8"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtConvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversation Title"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtConvPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last message preview..."
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/txtConvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just now"
            android:textSize="10sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRenameConv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_edit"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        app:tint="#94A3B8"
        android:scaleType="fitCenter"
        android:contentDescription="Rename Conversation" />

    <ImageButton
        android:id="@+id/btnDeleteConv"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        app:tint="#F87171"
        android:scaleType="fitCenter"
        android:contentDescription="Delete Conversation" />

</LinearLayout>
