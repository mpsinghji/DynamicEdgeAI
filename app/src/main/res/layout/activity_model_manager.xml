<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg"
    android:fitsSystemWindows="true">

    <!-- Header (Morphe/ReVanced Inspired Sleek Header) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_header_bg"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circular_action_btn"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            app:tint="@color/app_text_primary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edge Models"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary" />

            <TextView
                android:id="@+id/txtAppVersionModelManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 local models • On-device intelligence"
                android:textSize="12sp"
                android:textColor="@color/app_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStorageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Free: --"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:background="@drawable/bg_status_badge_cloud"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </RelativeLayout>

    <!-- Model List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/modelListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

</LinearLayout>
