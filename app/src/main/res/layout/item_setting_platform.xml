<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/app_surface_card"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/platformActionButtons">

                <TextView
                    android:id="@+id/txtPlatformName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Gemini"
                    android:textColor="@color/app_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPlatformModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Model: gemini-2.5-flash"
                    android:textColor="@color/app_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/platformActionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnPlatformGetKey"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get Key ↗"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="6dp" />

                <ImageButton
                    android:id="@+id/btnPlatformCloseCard"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/app_text_muted"
                    android:padding="6dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Close" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/txtPlatformKeyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Key Configured"
            android:textColor="#16A34A"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnPlatformClear"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Clear"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnPlatformConfigure"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Configure Key"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_primary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
