<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_key"
            android:background="@drawable/menu_icon_bg"
            android:padding="7dp"
            app:tint="@color/accent_blue"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Key Configuration"
                android:textColor="@color/app_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCurrentKeyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current: Not configured"
                android:textColor="@color/app_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your personal API key for AI inference. Keys are securely stored client-side only on this device."
        android:textColor="@color/app_text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="14dp" />

    <!-- Input Field -->
    <EditText
        android:id="@+id/editApiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Paste your API key here"
        android:textSize="14sp"
        android:textColor="@color/app_text_primary"
        android:textColorHint="@color/app_text_muted"
        android:background="@drawable/bg_input_outline"
        android:padding="12dp"
        android:inputType="textVisiblePassword"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelApiKey"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/app_text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnClearApiKey"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="#EF4444"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveApiKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Key"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_blue" />
    </LinearLayout>
</LinearLayout>
