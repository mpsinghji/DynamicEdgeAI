<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        android:elevation="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_app_logo"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/appTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adaptive Edge AI"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/appSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intelligent Adaptive AI System"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- New Chat quick button -->
            <ImageButton
                android:id="@+id/btnHeaderNewChat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E88E5"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:contentDescription="New Chat"
                android:layout_marginEnd="6dp" />

            <!-- Conversations history quick button -->
            <ImageButton
                android:id="@+id/btnHeaderConversations"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_history"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#455A64"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:contentDescription="Chat History"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginEnd="4dp"/>

            <Switch
                android:id="@+id/privacyModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:checked="false" />

            <LinearLayout
                android:id="@+id/insightsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:id="@+id/insightsToggleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insights"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginEnd="4dp"/>
                <ImageView
                    android:id="@+id/insightsInfoIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ai_small"
                    app:tint="#666666" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Floating Top Update Notification Banner (Auto-checks on start, auto-hides) -->
    <include
        layout="@layout/layout_update_popup_banner"
        android:id="@+id/includedUpdateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginTop="8dp" />

    <!-- Insights Card -->
    <LinearLayout
        android:id="@+id/insightsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_insights"
            android:orientation="vertical"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_outline"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Telemetry"
                    android:textSize="12sp"
                    android:textColor="#555555" />

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                <TextView
                    android:id="@+id/insightModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/mode_local" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/ramIndicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_check_green"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:id="@+id/ramLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM: --"
                            android:textSize="11sp"
                            android:textColor="#444444" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">
                        <ImageView
                            android:id="@+id/cpuIndicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/dot_green"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:id="@+id/cpuLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU: --"
                            android:textSize="11sp"
                            android:textColor="#444444" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/networkLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Network: --"
                        android:textSize="11sp"
                        android:textColor="#444444" />

                    <TextView
                        android:id="@+id/batteryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battery: --"
                        android:textSize="11sp"
                        android:textColor="#444444"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Area -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/insightsContainer"
        android:layout_above="@+id/inputArea"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/thinkingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble_ai"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/thinkingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thinking..."
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer Input with Image Preview and Attachment Support -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:orientation="vertical"
        android:elevation="8dp">

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" />

        <!-- Image Attachment Preview Box (visible when image attached) -->
        <LinearLayout
            android:id="@+id/imagePreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgPreviewThumbnail"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="@drawable/card_outline" />

            <TextView
                android:id="@+id/txtPreviewFilename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="image.jpg"
                android:textSize="12sp"
                android:textColor="#333333"
                android:singleLine="true"
                android:ellipsize="middle" />

            <ImageButton
                android:id="@+id/btnRemoveImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#F44336"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/input_bg"
                android:src="@drawable/ic_menu"
                app:tint="#666666" />

            <!-- Gallery Image Picker Button -->
            <ImageButton
                android:id="@+id/btnAttachImage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/input_bg"
                android:src="@drawable/ic_image"
                app:tint="#666666"
                android:contentDescription="Attach Image" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="Ask anything here..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp"
                android:textColor="#222222"
                android:textColorHint="#777777"
                android:inputType="textLongMessage" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/input_bg"
                android:backgroundTint="@color/btn_blue"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
