<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fitsSystemWindows="true">

    <!-- Top App Header (Brand + Circular Action Buttons - Zero Overlap) -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_header_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:elevation="3dp">

        <!-- Left Brand & Title -->
        <LinearLayout
            android:id="@+id/headerBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/headerActions"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_app_logo"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/appTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DynamicEdgeAI"
                    android:textColor="@color/app_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/appSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edge &amp; Cloud Intelligence"
                    android:textColor="@color/app_text_muted"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Quick Action Bar (3 Circular Dark Buttons) -->
        <LinearLayout
            android:id="@+id/headerActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- History quick button -->
            <ImageButton
                android:id="@+id/btnHeaderConversations"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_history"
                android:background="@drawable/bg_circular_action_btn"
                app:tint="@color/app_text_secondary"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:contentDescription="Chat History"
                android:layout_marginEnd="8dp" />

            <!-- New Chat quick button -->
            <ImageButton
                android:id="@+id/btnHeaderNewChat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_circular_action_btn"
                app:tint="@color/accent_blue"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:contentDescription="New Chat"
                android:layout_marginEnd="8dp" />

            <!-- Settings quick button -->
            <ImageButton
                android:id="@+id/btnHeaderSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_circular_action_btn"
                app:tint="@color/app_text_secondary"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:contentDescription="Settings" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Floating Top Update Notification Banner (Auto-checks on start, auto-hides) -->
    <include
        layout="@layout/layout_update_popup_banner"
        android:id="@+id/includedUpdateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginTop="4dp" />

    <!-- Slim, Minimal System Telemetry Pill (Never blocks chat view, battery removed) -->
    <LinearLayout
        android:id="@+id/insightsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/includedUpdateBanner"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_telemetry_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Live Pulsing Status Dot -->
            <ImageView
                android:id="@+id/ramIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/dot_green"
                android:layout_marginEnd="6dp" />

            <!-- Compact Stream of Live Metrics: RAM • CPU • Network -->
            <TextView
                android:id="@+id/ramLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- GB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textSize="11sp"
                android:textColor="@color/app_text_muted" />

            <TextView
                android:id="@+id/cpuLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU --%"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textSize="11sp"
                android:textColor="@color/app_text_muted" />

            <TextView
                android:id="@+id/networkLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wi-Fi"
                android:textSize="11sp"
                android:textColor="@color/app_text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Status Badge (LOCAL / CLOUD) -->
            <TextView
                android:id="@+id/insightModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL"
                android:textStyle="bold"
                android:textSize="10sp"
                android:textColor="#16A34A"
                android:background="@drawable/bg_status_badge_local"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <!-- Stub for privacyModeToggle to maintain code compatibility -->
            <Switch
                android:id="@+id/privacyModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Message Area -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/insightsContainer"
        android:layout_above="@+id/inputArea"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/thinkingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble_ai"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/thinkingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thinking..."
                    android:textColor="@color/app_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer Input Bar (Anchored at Bottom - No Bottom Navigation Bar) -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/app_bg"
        android:orientation="vertical"
        android:elevation="6dp">

        <!-- Top subtle divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/app_surface_outline" />

        <!-- Image Attachment Preview Box (supports multiple images) -->
        <LinearLayout
            android:id="@+id/imagePreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header Row: Count & Clear All -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/imgPreviewThumbnail"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_image"
                    app:tint="@color/accent_blue"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/txtPreviewFilename"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1 image attached"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_text_primary"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/btnClearAllImages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear All"
                    android:textSize="11sp"
                    android:textColor="#F87171"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageButton
                    android:id="@+id/btnRemoveImage"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#F87171"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Horizontal Scroll of Thumbnails -->
            <HorizontalScrollView
                android:id="@+id/scrollPreviewThumbnails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerPreviewThumbnails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Three horizontal lines Menu Button (Models & RAM) -->
            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_circular_action_btn"
                android:src="@drawable/ic_menu"
                app:tint="@color/app_text_secondary"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Models &amp; RAM" />

            <!-- Camera Quick Button (Direct Camera Snap) -->
            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_circular_action_btn"
                android:src="@drawable/ic_camera"
                app:tint="@color/app_text_secondary"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Take Photo" />

            <!-- Gallery Image Picker Button (Multiple Images) -->
            <ImageButton
                android:id="@+id/btnAttachImage"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_circular_action_btn"
                android:src="@drawable/ic_image"
                app:tint="@color/app_text_secondary"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Attach Images" />

            <!-- Capsule Text Input -->
            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input_pill"
                android:hint="Ask anything here..."
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_muted"
                android:inputType="textLongMessage" />

            <!-- Circular Electric Blue Send Button -->
            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_circular_action_btn"
                android:backgroundTint="@color/btn_blue"
                android:src="@drawable/ic_send"
                app:tint="@color/white"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:contentDescription="Send" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
