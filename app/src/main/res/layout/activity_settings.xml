<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fitsSystemWindows="true">

    <!-- Top Toolbar -->
    <RelativeLayout
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/app_header_bg"
        android:elevation="3dp"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnSettingsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/app_text_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnSettingsBack"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="Settings &amp; Providers"
            android:textColor="@color/app_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/settingsToolbar"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="84dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 0: Appearance & Theme Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance &amp; Theme"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_surface_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme Mode"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Switch between Dark mode, Light mode, or follow your phone system."
                        android:textSize="11sp"
                        android:textColor="@color/app_text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioThemeSystem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="System Default (Follows OS setting)"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:textSize="13sp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioThemeDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dark Mode (AMOLED Midnight)"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:textSize="13sp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioThemeLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Light Mode (Clean Day)"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:textSize="13sp"
                            android:paddingStart="6dp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 1: Inference Routing Override -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inference Execution Strategy"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_surface_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Execution Mode Override"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose how prompts are processed or let the Decision Engine dynamically adapt."
                        android:textSize="11sp"
                        android:textColor="@color/app_text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupInferenceOverride"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioOverrideOff"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OFF (Adaptive Engine) — Auto-switch by telemetry"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:textSize="13sp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioOverrideLocal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="LOCAL — Force on-device Edge AI"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/status_green"
                            android:textSize="13sp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioOverrideCloud"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CLOUD — Force Cloud AI provider"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/mode_cloud"
                            android:textSize="13sp"
                            android:paddingStart="6dp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 2: Active Cloud Provider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Cloud AI Provider"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_surface_card"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select provider used when routing to Cloud AI:"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupProviders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radioGemini"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Google Gemini (Gemini 2.5 Flash)"
                            android:textSize="14sp"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:paddingVertical="4dp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioOpenAI"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OpenAI (GPT-4o mini)"
                            android:textSize="14sp"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:paddingVertical="4dp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioGroq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Groq (Llama 3.3 70B - Ultra Fast)"
                            android:textSize="14sp"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:paddingVertical="4dp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioOpenRouter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="OpenRouter (Universal Model Router)"
                            android:textSize="14sp"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:paddingVertical="4dp"
                            android:paddingStart="6dp" />

                        <RadioButton
                            android:id="@+id/radioAnthropic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Anthropic Claude (Claude 3.5 Haiku)"
                            android:textSize="14sp"
                            android:textColor="@color/app_text_primary"
                            android:buttonTint="@color/accent_blue"
                            android:paddingVertical="4dp"
                            android:paddingStart="6dp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 3: Platform API Keys (Compressed into Dropdown) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client-Side API Keys"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a provider from the dropdown to view or configure API keys. All keys remain 100% on your device."
                android:textColor="@color/app_text_secondary"
                android:textSize="11sp"
                android:layout_marginBottom="10dp" />

            <!-- Compressed Dropdown Selector Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Provider to Configure Key:"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_text_primary"
                        android:layout_marginBottom="6dp" />

                    <!-- Sleek Spinner Dropdown -->
                    <Spinner
                        android:id="@+id/spinnerApiKeyProvider"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/card_outline"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:spinnerMode="dropdown" />

                    <!-- Quick Status Badges Stream -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/containerKeyQuickChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Dynamic Platform Card Container (Shown only when provider is selected) -->
            <LinearLayout
                android:id="@+id/platformCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp" />

            <!-- Section 4: Privacy & Long-Term Memory -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy &amp; Memory"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/switchSettingsMemory">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Long-Term Chat Memory"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/app_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Extracts preferences and instructions across chats"
                                android:textSize="11sp"
                                android:textColor="@color/app_text_secondary" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchSettingsMemory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <Button
                        android:id="@+id/btnManageAllMemories"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Inspect &amp; Manage Stored Memories"
                        android:textColor="@color/accent_blue"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 5: About & System Version -->
            <TextView
                android:id="@+id/txtSettingsAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DynamicEdgeAI"
                android:gravity="center"
                android:textColor="@color/app_text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Check for Updates Button -->
            <Button
                android:id="@+id/btnSettingsCheckUpdates"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Check for Updates"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:background="@drawable/bg_input_outline"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtSettingsUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open Source on GitHub: mpsinghji/DynamicEdgeAI"
                android:gravity="center"
                android:textColor="@color/app_text_muted"
                android:textSize="11sp"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Floating Bottom Navigation Dock (Centered Capsule matching Morphe Design) -->
    <LinearLayout
        android:id="@+id/floatingBottomDockSettings"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_bottom_bar"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Chat Tab -->
        <LinearLayout
            android:id="@+id/btnNavChatSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chat"
                app:tint="@color/app_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textSize="12sp"
                android:textColor="@color/app_text_muted"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Models Tab -->
        <LinearLayout
            android:id="@+id/btnNavModelsSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_cpu"
                app:tint="@color/app_text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Models"
                android:textSize="12sp"
                android:textColor="@color/app_text_muted"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Settings Tab (Active Highlighted Pill) -->
        <LinearLayout
            android:id="@+id/btnNavSettingsCurrent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_floating_nav_active">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/accent_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
