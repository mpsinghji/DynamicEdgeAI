<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/downloadTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading Model..."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/downloadStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textSize="10sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"/>

        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:progress="0"
            android:max="100"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/downloadPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="10sp"
                android:textColor="#666666"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnRetryDownload"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#2196F3"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btnPauseResume"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_pause"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#666666"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btnCancelDownload"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#F44336"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
