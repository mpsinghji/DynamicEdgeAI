<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/handle_bar" />

    <!-- Scrollable Quick Action Menu Items -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- New Chat -->
            <LinearLayout
                android:id="@+id/menuNewChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_add"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="New Chat"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Conversations History -->
            <LinearLayout
                android:id="@+id/menuConversations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_history"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chats"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Long-Term Memory -->
            <LinearLayout
                android:id="@+id/menuMemories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_ai_small"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Memory"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Models -->
            <LinearLayout
                android:id="@+id/menuModelManager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_download"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Models"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>

            <!-- RAM -->
            <LinearLayout
                android:id="@+id/menuAdjustRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="RAM"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Software Updates -->
            <LinearLayout
                android:id="@+id/menuCheckUpdates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_download"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Updates"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Embedded Software Update Card -->
    <include
        layout="@layout/layout_update_card"
        android:id="@+id/bottomSheetUpdateCard" />

    <!-- Current model info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Installed Local Models"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/btnManageModelsLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage →"
            android:textSize="12sp"
            android:textColor="#1E88E5"
            android:textStyle="bold"
            android:padding="4dp" />
    </LinearLayout>

    <!-- List of downloaded models -->
    <LinearLayout
        android:id="@+id/menuModelsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- Version string at the very bottom -->
    <TextView
        android:id="@+id/txtMenuVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="DynamicEdgeAI • v1.1.2"
        android:textSize="11sp"
        android:textColor="#AAAAAA" />

</LinearLayout>
