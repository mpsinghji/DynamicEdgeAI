<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/handle_bar" />

    <!-- Quick Action Menu Items: Models and RAM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Models -->
        <LinearLayout
            android:id="@+id/menuModelManager"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_download"
                app:tint="@color/accent_blue"
                android:background="@drawable/menu_icon_bg"
                android:padding="10dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Models"
                android:textSize="12sp"
                android:textColor="@color/app_text_primary"
                android:gravity="center" />
        </LinearLayout>

        <!-- RAM -->
        <LinearLayout
            android:id="@+id/menuAdjustRam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/accent_blue"
                android:background="@drawable/menu_icon_bg"
                android:padding="10dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="RAM"
                android:textSize="12sp"
                android:textColor="@color/app_text_primary"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Current model info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Installed Local Models"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/app_text_secondary" />

        <TextView
            android:id="@+id/btnManageModelsLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage →"
            android:textSize="12sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:padding="4dp" />
    </LinearLayout>

    <!-- List of downloaded models -->
    <LinearLayout
        android:id="@+id/menuModelsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- Version string at the very bottom -->
    <TextView
        android:id="@+id/txtMenuVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="DynamicEdgeAI"
        android:textSize="11sp"
        android:textColor="@color/app_text_muted" />

</LinearLayout>
