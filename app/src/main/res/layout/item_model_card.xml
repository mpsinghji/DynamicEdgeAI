<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modelCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/app_surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Morphe-Style Sleek Header Row (Clickable to Expand/Collapse) -->
        <RelativeLayout
            android:id="@+id/cardHeaderClickArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <!-- 48dp Circular Avatar with Overlapping Status Badge -->
            <RelativeLayout
                android:id="@+id/avatarContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp">

                <ImageView
                    android:id="@+id/modelAvatarIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_cpu"
                    android:background="@drawable/menu_icon_bg"
                    android:padding="10dp"
                    app:tint="@color/accent_blue" />

                <!-- Small Overlapping Status Badge (Verified Shield or Globe) -->
                <ImageView
                    android:id="@+id/modelStatusBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:src="@drawable/ic_verified_badge"
                    android:background="@drawable/bg_circular_action_btn"
                    android:padding="2dp" />
            </RelativeLayout>

            <!-- Title & Subtitle Info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/avatarContainer"
                android:layout_toStartOf="@+id/chevronAndBadges"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtModelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model Name"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/app_text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtModelSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="3.4 GB • Active"
                    android:textSize="13sp"
                    android:textColor="@color/app_text_muted"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Right End: Badges & Down Chevron -->
            <LinearLayout
                android:id="@+id/chevronAndBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/badgeActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_status"
                    android:text="Active"
                    android:textSize="10sp"
                    android:textColor="#16A34A"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/badgeRecommended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_recommended"
                    android:text="★ Best"
                    android:textSize="10sp"
                    android:textColor="#D97706"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginEnd="6dp" />

                <!-- Down Chevron that rotates on expand -->
                <ImageView
                    android:id="@+id/btnExpandChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/app_text_secondary"
                    android:contentDescription="Expand" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Hidden Compatibility Status Label for Legacy Listeners -->
        <TextView
            android:id="@+id/txtModelStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Expandable Details Container (Collapsed by Default) -->
        <LinearLayout
            android:id="@+id/cardDetailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Subtle Thin Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginBottom="12dp" />

            <!-- Model Description -->
            <TextView
                android:id="@+id/txtModelDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Model description"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/app_text_secondary" />

            <!-- Technical Specification Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRamReq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Min 4 GB RAM"
                    android:textSize="11sp"
                    android:textColor="@color/app_text_secondary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="LiteRT 4-bit"
                    android:textSize="11sp"
                    android:textColor="@color/accent_blue"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/chipContext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="4K Context"
                    android:textSize="11sp"
                    android:textColor="@color/app_text_muted" />
            </LinearLayout>

            <!-- Download Progress Monitor (visible during active download) -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_outline"
                android:padding="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/modelProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progressDrawable="@drawable/progress_bar_blue"
                    android:progress="0"
                    android:max="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDownloadSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 MB / 0 MB"
                        android:textSize="11sp"
                        android:textColor="@color/app_text_secondary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_blue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDownloadSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speed: --"
                        android:textSize="10sp"
                        android:textColor="@color/accent_blue" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtDownloadEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaining: --"
                        android:textSize="10sp"
                        android:textColor="@color/app_text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtProgressStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Downloading..."
                    android:textSize="10sp"
                    android:textColor="@color/app_text_muted" />
            </LinearLayout>

            <!-- Action Buttons Row (Material Pill Buttons) -->
            <LinearLayout
                android:id="@+id/actionButtonsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="end">

                <!-- Download Pill Button -->
                <LinearLayout
                    android:id="@+id/btnDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_download"
                        app:tint="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Download"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Pause/Resume Button -->
                <ImageButton
                    android:id="@+id/btnPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_pause"
                    android:background="@drawable/bg_circular_action_btn"
                    app:tint="@color/app_text_secondary"
                    android:visibility="gone"
                    android:contentDescription="Pause" />

                <!-- Cancel Button -->
                <ImageButton
                    android:id="@+id/btnCancel"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/bg_circular_action_btn"
                    app:tint="#DC2626"
                    android:visibility="gone"
                    android:contentDescription="Cancel" />

                <!-- Repair Button -->
                <LinearLayout
                    android:id="@+id/btnRepair"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_badge"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_repair"
                        app:tint="#D97706" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repair"
                        android:textSize="12sp"
                        android:textColor="#D97706"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Uninstall / Delete Pill Button -->
                <LinearLayout
                    android:id="@+id/btnUninstall"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circular_action_btn"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_delete"
                        app:tint="#DC2626" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uninstall"
                        android:textSize="12sp"
                        android:textColor="#DC2626"
                        android:textStyle="bold"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- Use This Model (Set Active) Pill Button -->
                <LinearLayout
                    android:id="@+id/btnUseModel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_status_badge_local"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal"
                    android:layout_marginStart="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_check_green"
                        app:tint="#16A34A"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set Active"
                        android:textSize="12sp"
                        android:textColor="#16A34A"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
